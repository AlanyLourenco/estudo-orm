<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="escola" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- as classes que o ORM sabe guardar -->
        <class>modelo.Aluno</class>
        <class>modelo.Turma</class>
        <class>modelo.Disciplina</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- URL, usuário e senha vêm de db.properties (ver persistencia.JPA) -->

            <!-- a cada execução o Hibernate apaga e recria as tabelas: a demonstração sempre começa igual -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>

            <!-- mostra no console cada SQL enviado ao banco -->
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
